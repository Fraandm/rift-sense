# Copia este archivo a .env y rellena lo que necesites.
# La app funciona sin clave de Riot usando el dataset profesional de Leaguepedia.

# --- Riot API (opcional) -----------------------------------------------------
# https://developer.riotgames.com/   (una key de desarrollo caduca cada 24 h)
RIOT_API_KEY=

# Region para el scraping de high elo: euw1, na1, kr, br1, la1, la2, lan, las...
RIOT_REGION=euw1

# --- Scraping ---------------------------------------------------------------
# Fecha mínima de partidas profesionales a descargar (YYYY-MM-DD)
LP_SINCE=2024-01-01

# Contacto para el User-Agent de Leaguepedia (su API lo recomienda)
LP_CONTACT=tu-correo@ejemplo.com
